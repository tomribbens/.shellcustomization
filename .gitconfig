[user]
	name = Tom Ribbens
	email = tom@tomribbens.be
[push]
	default = matching
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadOf = https://github.com/
[pull]
	ff = only
[rerere]
	enabled = true
[fetch]
	prune = true
[core]
	editor = vim
	excludesfile = ~/.gitignore_global
[rebase]
	autostash = true
[merge]
	conflictstyle = zdiff3
[commit]
	verbose = true
[diff]
	algorithm = histogram
	colorMoved = zebra
[color]
	ui = auto
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate
[safe]
	directory = /home/tom/github-actions-runner/_work/mobitwin-companion/mobitwin-companion
	directory = /home/tom/gh-action-runners/manimo-tests/_work/94-manimo-v2/94-manimo-v2
	directory = /home/tom/gh-action-runners/mobitwin-deploy/_work/mobitwin-companion/mobitwin-companion
